            subroutine th_C(nt,npt,ra,dec,x,y,z,npt1,x1,y1,z1,nsep,sep,sbound,mxh1,mxh2,cntid,logf,progressf,sk1,ll1,cdth) ! in :cflibfor:cflibfor.f90:mod
