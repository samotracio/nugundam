            subroutine th_Ab_wg(nt,npt,dec,wei,x,y,z,nsep,sep,sbound,mxh1,mxh2,nbts,bseed,wfib,cntid,logf,progressf,sk,ll,aa,baa,normb,sumwb) ! in :cflibfor:cflibfor.f90:mod
